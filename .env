OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin

# ==========================
# LiveKit
# ==========================

LIVEKIT_API_KEY=devkey

# Troque esta chave por uma com mais de 32 caracteres
LIVEKIT_API_SECRET=MinhaChaveSuperSecretaComMaisDe32Caracteres

# URL usada pelos containers
LIVEKIT_URL=ws://livekit:7880

# URL usada pelo navegador
PUBLIC_LIVEKIT_URL=ws://localhost:7880

# URL HTTP usada pelo script create_sip.py
LIVEKIT_HTTP_URL=http://localhost:7880

# ==========================
# SIP
# ==========================

SIP_PORT=5061

RTP_PORT_START=20000
RTP_PORT_END=20200

SIP_USE_EXTERNAL_IP=false